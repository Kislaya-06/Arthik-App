{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "index.ts",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "supabase"
  ]
}